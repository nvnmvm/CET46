# Copy to server/.env on the server and chmod 600 it. Never commit the real file.
NODE_ENV=production
API_PORT=3000
APP_ORIGIN=https://your-domain.example
COOKIE_SECURE=true
SESSION_SECRET=replace-with-a-random-value-of-at-least-32-characters
MYSQL_DATABASE=cet_words
MYSQL_USER=cet_words_app
MYSQL_PASSWORD=replace-with-a-long-random-password
# `docker inspect openresty` 读取到的现有网络名，不是公网地址。
OPENRESTY_NETWORK=replace-with-the-existing-openresty-network-name
