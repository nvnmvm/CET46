# 前端 API 根地址。生产环境使用同源 /api，因此通常留空；当前本地版本暂未读取。
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# 以下变量只用于后端进程（server/）。
# 绝对不要加 VITE_ 前缀：带该前缀的值会被打包进前端产物并公开。
# 这里只放占位符，真实值请写入 server/.env（已在 .gitignore 中忽略）。
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=3000
# 默认只监听本机。Docker 部署由 compose 覆盖为 0.0.0.0，并仅加入 OpenResty 的私有 Docker 网络。
API_HOST=127.0.0.1
APP_ORIGIN=http://localhost:4173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cet_words
MYSQL_USER=cet_words_app
MYSQL_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false

# 可选：migration 专用账号（建议生产环境使用；有建表权限，不用于日常读写）
# MYSQL_MIGRATION_USER=
# MYSQL_MIGRATION_PASSWORD=

# 本地运行真实 MySQL 集成测试：先执行 db:migrate，再设置 RUN_MYSQL_TESTS=1，
# 并使用上面的 MYSQL_* 连接变量。没有 MySQL 时测试会明确跳过。
