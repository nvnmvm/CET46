NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000

# 必须填写实际 HTTPS 源地址；不要使用公网 IP + HTTP 作为正式登录入口。
APP_ORIGIN=https://your-domain.example
COOKIE_SECURE=true
SESSION_SECRET=replace-with-at-least-32-random-characters

# Compose 内部服务名；不要改成公网地址。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=cet_words
MYSQL_USER=cet_words_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# 可选：迁移时使用有建表权限的独立账号；不填则回退到 MYSQL_USER。
# MYSQL_MIGRATION_USER=
# MYSQL_MIGRATION_PASSWORD=
